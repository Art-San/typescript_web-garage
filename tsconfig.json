{
  "compilerOptions": {
    "target": "ES2022", // Определяет версию JS на выходе
    "module": "NodeNext", // Значение `NodeNext` является критическим для современной разработки на Node.js.
    "moduleResolution": "NodeNext", // Оно решает извечную «головную боль» совместимости между старыми модулями CommonJS и новыми ECMAScript Modules (ESM).

    "noImplicitAny": true, // Блокирует «тихого убийцу» типизации — тип `any`

    /* 1. Главный рубильник строгой типизации */
    "strict": true, // проверяет все возможные ошибки

    /* 2. Удаляем ручные отключения: strictNullChecks ДОЛЖЕН БЫТЬ true! (можно удалить строку, так как strict: true уже включает его) */
    "strictNullChecks": true, // Проверяет, что значения не равны `null` или `undefined`

    /* 3. Независимые флаги повышенной строгости (они НЕ входят в strict) */
    "noUncheckedIndexedAccess": true, // Безопасная работа с массивами
    "exactOptionalPropertyTypes": true, // Тонкое различие между «свойство отсутствует» и «свойство равно `undefined`»
    "noImplicitReturns": true, // Гарантирует, что функция не «забудет» вернуть значение.
    "noFallthroughCasesInSwitch": true, // Запрещает случайный пропуск break в switch

    /* 4. Чистота кода */
    "noUnusedLocals": true, // Ошибка на неиспользованные локальные переменные
    "noUnusedParameters": true, // Ошибка на неиспользованные аргументы функций

    /* 5. Настройки сборки */
    "rootDir": "src", // Определяет корневую папку для входных файлов
    "outDir": "dist", // Определяет папку для выходных файлов
    "noEmitOnError": true, // Стратегический запрет на компиляцию при наличии ошибок

    /* 6. Дополнительные настройки */
    // "declaration": true, // Включает генерацию файлов деклараций (.d.ts)
    // "declarationMap": true // Включает генерацию карт исходного кода для деклараций
  },
  "include": ["src"] // Определяет папку для входных файлов
}
